<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        The customer or vendor an outside person represents: a client's contact, a subcontractor's
        site lead. The related scope uses it, so a client sees the records carrying their customer
        and nothing else. Exactly one of customer_id and vendor_id is set, each with its own
        foreign key rather than one untyped id, and the composite keys keep the employee, the
        customer and the vendor in the row's own organization.
    -->

    <changeSet id="access-005-create-access_party_link" author="echno">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="access_party_link"/></not>
        </preConditions>
        <createTable tableName="access_party_link">
            <column name="id" type="UUID"><constraints primaryKey="true" primaryKeyName="pk_access_party_link" nullable="false"/></column>
            <column name="organization_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="employee_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="customer_id" type="UUID"/>
            <column name="vendor_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="created_by" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="access_party_link" baseColumnNames="organization_id"
                                 referencedTableName="organization" referencedColumnNames="id"
                                 constraintName="fk_access_party_link_organization" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="access_party_link" baseColumnNames="organization_id, employee_id"
                                 referencedTableName="employee" referencedColumnNames="organization_id, id"
                                 constraintName="fk_access_party_link_employee" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="access_party_link" baseColumnNames="organization_id, customer_id"
                                 referencedTableName="customers" referencedColumnNames="organization_id, id"
                                 constraintName="fk_access_party_link_customer" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="access_party_link" baseColumnNames="organization_id, vendor_id"
                                 referencedTableName="vendor" referencedColumnNames="organization_id, id"
                                 constraintName="fk_access_party_link_vendor" onDelete="CASCADE"/>
        <createIndex tableName="access_party_link" indexName="idx_access_party_link_employee">
            <column name="employee_id"/>
        </createIndex>
        <createIndex tableName="access_party_link" indexName="idx_access_party_link_customer">
            <column name="customer_id"/>
        </createIndex>
        <createIndex tableName="access_party_link" indexName="idx_access_party_link_vendor">
            <column name="vendor_id"/>
        </createIndex>
        <sql>
            ALTER TABLE access_party_link
                ADD CONSTRAINT ck_access_party_link_one_party
                CHECK ((customer_id IS NULL) != (vendor_id IS NULL))
        </sql>
    </changeSet>

</databaseChangeLog>
