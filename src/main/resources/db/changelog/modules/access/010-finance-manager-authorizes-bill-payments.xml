<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Finance Manager's first starting grant: authorizing a contractor bill payment, the product
        owner's decision of 8 Nov that finance or the person controlling the project authorizes
        payments, not the system admin. System Admin is not given it.

        A file of its own because 008 loads role-template-grants.csv with no runOnChange, so an edit to
        that file would change 008's checksum on every database it has run on. The reconciler carries
        the new cell to each organization's Finance Manager role at the next boot, unless the
        organization has customized that role.
    -->

    <changeSet id="access-010-finance-manager-authorize-payment" author="abhijith">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT count(*) FROM access_role_template_grant
                WHERE template_id = 'f5fd45ee-efab-5d36-b1be-3afe82d391a4'
                  AND permission_key = 'progress-bills:authorize-payment'
            </sqlCheck>
        </preConditions>
        <loadData tableName="access_role_template_grant" file="db/data/access/role-template-grants-payments.csv" separator=",">
            <column name="id" type="UUID"/>
            <column name="template_id" type="UUID"/>
            <column name="permission_key" type="STRING"/>
            <column name="scope" type="STRING"/>
        </loadData>
    </changeSet>

</databaseChangeLog>
