<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Finance splits into areas (echno-backend #914), so each converts onto the matrix without
        changing anyone's access.

        expenses: expenses and receipts, which any member reads and the system admin and project
        manager create, edit and delete. The baseline gains expenses:read in place of the
        finance:read it held only for them; the rest of finance (ledger, invoices, payments, budgets,
        bank accounts) is read by the pair alone.

        payables: the web payables, which only the system admin reads, raises and pays.

        finance:configure: the finance writes only the system admin makes today (the chart of
        accounts' import and defaults, the cost categories' defaults, the posting mappings and the
        finance settings), so the project manager's finance writes stay as they are.

        A file of its own because 008 loads role-template-grants.csv with no runOnChange, so the
        baseline's finance:read row is deleted here rather than from that file. The reconciler carries
        the template to every uncustomized role on the next boot, in both directions: it adds these
        rows and removes the dropped one. A customized role is left as its organization set it.
    -->

    <changeSet id="access-011-finance-areas" author="abhijith">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT count(*) FROM access_role_template_grant
                WHERE template_id = '2e1db9db-3d7d-59a3-90b4-d05b10e5f687'
                  AND permission_key = 'expenses:read'
            </sqlCheck>
        </preConditions>
        <delete tableName="access_role_template_grant">
            <where>template_id = '2e1db9db-3d7d-59a3-90b4-d05b10e5f687' AND permission_key = 'finance:read'</where>
        </delete>
        <loadData tableName="access_role_template_grant" file="db/data/access/role-template-grants-finance-areas.csv" separator=",">
            <column name="id" type="UUID"/>
            <column name="template_id" type="UUID"/>
            <column name="permission_key" type="STRING"/>
            <column name="scope" type="STRING"/>
        </loadData>
    </changeSet>

</databaseChangeLog>
