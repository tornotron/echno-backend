<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        documents:read-reports (echno-backend #914): the organization's PDF report, its tasks and
        material requests with their status counts, which only the system admin, the HR admin and the
        project manager read today. Every member reads, files, renames and removes attachments, so
        the report's read gets an action of their own and the move onto the matrix changes nobody's
        access.

        A file of its own because 008 loads role-template-grants.csv with no runOnChange. The
        reconciler carries the template to every uncustomized role on the next boot; a customized role
        is left as its organization set it.
    -->

    <changeSet id="access-017-documents-reports" author="abhijith">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT count(*) FROM access_role_template_grant
                WHERE template_id = 'ed34dfe6-5468-5f6e-b6ed-ef6eefccfce2'
                  AND permission_key = 'documents:read-reports'
            </sqlCheck>
        </preConditions>
        <loadData tableName="access_role_template_grant" file="db/data/access/role-template-grants-documents-reports.csv" separator=",">
            <column name="id" type="UUID"/>
            <column name="template_id" type="UUID"/>
            <column name="permission_key" type="STRING"/>
            <column name="scope" type="STRING"/>
        </loadData>
    </changeSet>

</databaseChangeLog>
