<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        org-profile (echno-backend #914): the organization as every member meets it. Today every member
        reads their organization, the modules switched on for it, whether its plan carries a feature and
        which payment provider checkout uses, and records usage against the plan; the system admin and
        HR admin change the organization's details. Everything else in org-admin is the system admin's
        alone: the subscription and its history, checkout and the mandate, the billing events, the
        installed modules, dataset consent, assigning people and roles to the organization, and deleting
        it. Read, create and edit all differ between the two, so the member side becomes an area of its
        own and the move onto the matrix changes nobody's access.

        The baseline held org-admin:read and org-admin:create only for the member side, which would have
        let every member read the subscription or assign a role, so both go; the HR admin held
        org-admin:edit only for the organization's details, which would have let it set dataset consent
        or change the plan, so that goes too. The baseline gets org-profile read and create, and the
        system admin and HR admin get org-profile:edit. The system admin read and created org-admin
        through the baseline, so it now holds org-admin:read and org-admin:create itself.

        A file of its own because 008 loads role-template-grants.csv with no runOnChange. The
        reconciler carries the template to every uncustomized role on the next boot, in both
        directions; a customized role is left as its organization set it.
    -->

    <changeSet id="access-018-org-profile" author="abhijith">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT count(*) FROM access_role_template_grant
                WHERE template_id = '2e1db9db-3d7d-59a3-90b4-d05b10e5f687'
                  AND permission_key = 'org-profile:read'
            </sqlCheck>
        </preConditions>
        <delete tableName="access_role_template_grant">
            <where>template_id = '2e1db9db-3d7d-59a3-90b4-d05b10e5f687'
                AND permission_key IN ('org-admin:read', 'org-admin:create')</where>
        </delete>
        <delete tableName="access_role_template_grant">
            <where>template_id = 'eed8ef8b-48a6-5997-8302-df4fe971bfd1'
                AND permission_key = 'org-admin:edit'</where>
        </delete>
        <loadData tableName="access_role_template_grant" file="db/data/access/role-template-grants-org-profile.csv" separator=",">
            <column name="id" type="UUID"/>
            <column name="template_id" type="UUID"/>
            <column name="permission_key" type="STRING"/>
            <column name="scope" type="STRING"/>
        </loadData>
    </changeSet>

</databaseChangeLog>
