<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        leave:adjust-balances and leave-policies (echno-backend #914). Today every employee raises,
        changes and decides leave on their own, and the system admin and HR admin act on anyone's,
        which the template already gives. Recalculating and adjusting a balance is the system admin's
        and the HR admin's alone, so it gets a named action. Leave policies are read and kept by the
        same pair while only the system admin creates one, so they become an area of their own, with
        keeping a policy as the named action maintain: edit would have to come with create, and the
        HR admin creates none today. Nothing is taken from any template.

        A file of its own because 008 loads role-template-grants.csv with no runOnChange. The
        reconciler carries the template to every uncustomized role on the next boot; a customized role
        is left as its organization set it.
    -->

    <changeSet id="access-020-leave" author="abhijith">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT count(*) FROM access_role_template_grant
                WHERE template_id = 'ed34dfe6-5468-5f6e-b6ed-ef6eefccfce2'
                  AND permission_key = 'leave-policies:read'
            </sqlCheck>
        </preConditions>
        <loadData tableName="access_role_template_grant" file="db/data/access/role-template-grants-leave.csv" separator=",">
            <column name="id" type="UUID"/>
            <column name="template_id" type="UUID"/>
            <column name="permission_key" type="STRING"/>
            <column name="scope" type="STRING"/>
        </loadData>
    </changeSet>

</databaseChangeLog>
