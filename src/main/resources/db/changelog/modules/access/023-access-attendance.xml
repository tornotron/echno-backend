<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        team, attendance records (echno-backend #914). Before the matrix every member recorded and read
        their own attendance and movements and asked to decide the records naming them as approver, and
        the record-management roles (echno.security.attendance.record-management-roles: system admin, HR
        admin and project manager, which no environment overrides) marked absences, read a project's or
        anyone's records, decided and verified anyone's, and deleted a record. The service checks that
        decide whose record a write or a by-id read touches are unchanged.

        Deleting an attendance record is the project manager's too, while deleting an employee is not, so
        it is the named team:delete-attendance. This changeset:
        - narrows the baseline's team:approve to its own records;
        - gives the system admin and HR admin team:approve and team:delete-attendance across the
          organization, and the project manager team:create, team:approve and team:delete-attendance
          across it.

        A file of its own because 008 loads role-template-grants.csv with no runOnChange. The reconciler
        carries the template to every uncustomized role on the next boot; a customized role is left as its
        organization set it.
    -->

    <changeSet id="access-023-attendance" author="abhijith">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT count(*) FROM access_role_template_grant
                WHERE template_id = 'ed34dfe6-5468-5f6e-b6ed-ef6eefccfce2'
                  AND permission_key = 'team:delete-attendance'
            </sqlCheck>
        </preConditions>
        <update tableName="access_role_template_grant">
            <column name="scope" value="OWN"/>
            <where>template_id = '2e1db9db-3d7d-59a3-90b4-d05b10e5f687' AND permission_key = 'team:approve' AND scope = 'ALL'</where>
        </update>
        <loadData tableName="access_role_template_grant" file="db/data/access/role-template-grants-attendance.csv" separator=",">
            <column name="id" type="UUID"/>
            <column name="template_id" type="UUID"/>
            <column name="permission_key" type="STRING"/>
            <column name="scope" type="STRING"/>
        </loadData>
    </changeSet>

</databaseChangeLog>
