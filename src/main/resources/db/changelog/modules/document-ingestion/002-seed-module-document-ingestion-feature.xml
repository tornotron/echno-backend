<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Seeds the feature the module is gated on and grants it on no plan. Nobody holds this module
        by default and it has no price yet; a grant is a billing data change once it has one.
        Design: docs/specs/2026-11-08-document-ingestion-design.md, section 6.7.

        Guarded on its own row, so an environment that already holds the feature keeps what it has.
    -->

    <changeSet id="document-ingestion-002-seed-feature" author="abhijith">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM feature WHERE code = 'MODULE_DOCUMENT_INGESTION'</sqlCheck>
        </preConditions>
        <insert tableName="feature">
            <column name="code" value="MODULE_DOCUMENT_INGESTION"/>
            <column name="name" value="Document Ingestion Module"/>
            <column name="description"
                    value="Access to the document ingestion module: tender documents read into candidate values that a person reviews and applies."/>
            <column name="feature_type" value="BOOLEAN"/>
            <column name="category" value="MODULE"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <rollback>
            <delete tableName="feature">
                <where>code = 'MODULE_DOCUMENT_INGESTION'</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
