<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- The inspection ontology as data, part 3 (#765): the element type catalogue, its       -->
    <!-- per-organization copy, and the applicability columns on checklist templates.          -->
    <!-- Design record docs/specs/2026-09-12-qaqc-ontology-as-data.md sections 3.3 and 3.4.    -->

    <changeSet id="105-01-create-element-type-catalogue" author="echno">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="element_type_catalogue"/></not>
        </preConditions>
        <comment>
            Global reference data: the construction element types the product ships. Same
            shape as trade_catalogue. A spatial node of level ELEMENT carries one of these codes
            as its element_type slug; no foreign key, so note 1 and this note deploy in either order.
        </comment>
        <createTable tableName="element_type_catalogue">
            <column name="code" type="VARCHAR(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="group_code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="105-02-seed-element-type-catalogue" author="echno">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM element_type_catalogue</sqlCheck>
        </preConditions>
        <comment>Seventeen common element types in five groups; organizations extend the list.</comment>
        <loadData tableName="element_type_catalogue" file="db/seed/inspections/element-type-catalogue.csv" separator=",">
            <column name="code" type="STRING"/>
            <column name="name" type="STRING"/>
            <column name="group_code" type="STRING"/>
            <column name="description" type="STRING"/>
            <column name="sort_order" type="NUMERIC"/>
            <column name="active" type="BOOLEAN"/>
        </loadData>
    </changeSet>

    <changeSet id="105-03-create-org-element-types" author="echno">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="org_element_types"/></not>
        </preConditions>
        <comment>
            The tenant-owned element type list: catalogue copies (catalogue_code set) and
            org-defined types (catalogue_code null). Same shape as inspection_trades without
            legacy_enum, since no enum ever stood behind these.
        </comment>
        <createTable tableName="org_element_types">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organization_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="group_code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="catalogue_code" type="VARCHAR(50)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="org_element_types"
                                 baseColumnNames="organization_id"
                                 constraintName="fk_org_element_type_organization"
                                 referencedTableName="organization"
                                 referencedColumnNames="id"
                                 onDelete="RESTRICT"/>
        <addUniqueConstraint tableName="org_element_types"
                             columnNames="organization_id, code"
                             constraintName="uk_org_element_type_code"/>
        <createIndex tableName="org_element_types" indexName="idx_org_element_type_active">
            <column name="organization_id"/>
            <column name="active"/>
        </createIndex>
        <sql>
            CREATE UNIQUE INDEX IF NOT EXISTS uk_org_element_type_catalogue_code
                ON org_element_types (organization_id, catalogue_code)
                WHERE catalogue_code IS NOT NULL
        </sql>
    </changeSet>

    <changeSet id="105-04-copy-element-types-into-organizations" author="echno">
        <comment>
            One org row per active catalogue code for every existing organization, idempotent on
            (organization_id, catalogue_code); ElementTypeService.ensureOrgElementTypes does the
            same lazily for organizations created later.
        </comment>
        <sql>
            INSERT INTO org_element_types (organization_id, code, name, group_code, description, sort_order, active, catalogue_code)
            SELECT o.id, c.code, c.name, c.group_code, c.description, c.sort_order, true, c.code
            FROM organization o
            CROSS JOIN element_type_catalogue c
            WHERE c.active
              AND NOT EXISTS (SELECT 1 FROM org_element_types e
                              WHERE e.organization_id = o.id AND e.catalogue_code = c.code)
        </sql>
    </changeSet>

    <changeSet id="105-05-add-template-applicability" author="echno">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="checklist_templates" columnName="applicable_element_types"/></not>
        </preConditions>
        <comment>
            The "Inspection Rule" of the reference model as a filter on the template: which
            element types and which project types it suits. Null means any. Suggestion only;
            any template may still be used on any element. Text arrays rather than the jsonb the
            design note named: the entity maps List&lt;String&gt; the way users_table.certifications
            does, since a JSON-typed List&lt;String&gt; collides with that mapping in Hibernate.
        </comment>
        <addColumn tableName="checklist_templates">
            <column name="applicable_element_types" type="TEXT[]"/>
            <column name="applicable_project_types" type="TEXT[]"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
