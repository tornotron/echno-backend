    <!-- The inspection ontology as data, part 4 (#766): starter checklists for the five     -->
    <!-- trades the catalogue added. Design record section 6 step 7. A short generic first    -->
    <!-- draft per trade, to be refined in the checklist builder; adopting one copies it into -->
    <!-- the organization, after which the two are independent.                               -->

    <changeSet id="106-01-seed-starter-checklists-for-new-trades" author="echno">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM starter_checklist_templates
                WHERE trade_code IN ('tiling', 'painting', 'ceilings', 'doors-windows', 'fire-systems')
            </sqlCheck>
        </preConditions>
        <comment>
            One starter per new trade, keyed by catalogue code as 104-05 requires. Guarded on
            the five codes so a database that already carries them, seeded by hand or by an
            earlier run, is left alone.
        </comment>
