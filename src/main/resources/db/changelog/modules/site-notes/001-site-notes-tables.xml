<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        The Site Notes module's table. site_note carries organization_id, which is what the
        entity's orgFilter runs on. The project and author columns are foreign keys into the
        core, not JPA associations.
    -->

    <changeSet id="site-notes-001-create-site_note" author="echno">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="site_note"/></not>
        </preConditions>
        <createTable tableName="site_note">
            <column name="id" type="UUID"><constraints primaryKey="true" primaryKeyName="pk_site_note" nullable="false"/></column>
            <column name="organization_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="project_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="note_date" type="DATE"><constraints nullable="false"/></column>
            <column name="author_employee_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="note" type="TEXT"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="site_note" baseColumnNames="organization_id"
                                 referencedTableName="organization" referencedColumnNames="id"
                                 constraintName="fk_site_note_organization"/>
        <addForeignKeyConstraint baseTableName="site_note" baseColumnNames="project_id"
                                 referencedTableName="project" referencedColumnNames="id"
                                 constraintName="fk_site_note_project"/>
        <addForeignKeyConstraint baseTableName="site_note" baseColumnNames="author_employee_id"
                                 referencedTableName="employee" referencedColumnNames="id"
                                 constraintName="fk_site_note_author"/>
        <createIndex tableName="site_note" indexName="idx_site_note_organization">
            <column name="organization_id"/>
        </createIndex>
        <createIndex tableName="site_note" indexName="idx_site_note_project_date">
            <column name="organization_id"/>
            <column name="project_id"/>
            <column name="note_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
