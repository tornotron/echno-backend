<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Seeds the feature the Work Progress module is gated on and grants it on every seeded plan.

        A module's entitlement key is a Feature row, and an organization has the module when its
        plan carries a plan_feature for it. Granting it on all four tiers means no tenant goes
        dark on cutover; a plan that omits it is how a tenant is made dark later, by a billing
        data change rather than a migration. Mirrors modules/toolbox-talks/002-seed-module-toolbox-talks-feature.xml.

        Each changeSet is guarded on its own row, so an environment that already holds the
        feature or a grant keeps what it has. The grants are also guarded on the plan existing,
        since a missing plan code would otherwise turn into a null plan_id.
    -->

    <changeSet id="work-progress-002-seed-feature-module-work-progress" author="echno">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM feature WHERE code = 'MODULE_WORK_PROGRESS'</sqlCheck>
        </preConditions>
        <insert tableName="feature">
            <column name="code" value="MODULE_WORK_PROGRESS"/>
            <column name="name" value="Work Progress Module"/>
            <column name="description" value="Access to the Work Progress module: progress inspections of schedule activities."/>
            <column name="feature_type" value="BOOLEAN"/>
            <column name="category" value="MODULE"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <rollback>
            <delete tableName="feature"><where>code = 'MODULE_WORK_PROGRESS'</where></delete>
        </rollback>
    </changeSet>

    <changeSet id="work-progress-002-grant-module-work-progress-free" author="echno">
        <preConditions onFail="MARK_RAN">
            <and>
                <sqlCheck expectedResult="1">SELECT COUNT(*) FROM plan WHERE code = 'FREE'</sqlCheck>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM plan_feature pf
                    JOIN plan p ON p.id = pf.plan_id
                    JOIN feature f ON f.id = pf.feature_id
                    WHERE p.code = 'FREE' AND f.code = 'MODULE_WORK_PROGRESS'
                </sqlCheck>
            </and>
        </preConditions>
        <insert tableName="plan_feature">
            <column name="plan_id" valueComputed="(SELECT id FROM plan WHERE code = 'FREE')"/>
            <column name="feature_id" valueComputed="(SELECT id FROM feature WHERE code = 'MODULE_WORK_PROGRESS')"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <rollback>
            <delete tableName="plan_feature">
                <where>plan_id = (SELECT id FROM plan WHERE code = 'FREE') AND feature_id = (SELECT id FROM feature WHERE code = 'MODULE_WORK_PROGRESS')</where>
            </delete>
        </rollback>
    </changeSet>

    <changeSet id="work-progress-002-grant-module-work-progress-starter" author="echno">
        <preConditions onFail="MARK_RAN">
            <and>
                <sqlCheck expectedResult="1">SELECT COUNT(*) FROM plan WHERE code = 'STARTER'</sqlCheck>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM plan_feature pf
                    JOIN plan p ON p.id = pf.plan_id
                    JOIN feature f ON f.id = pf.feature_id
                    WHERE p.code = 'STARTER' AND f.code = 'MODULE_WORK_PROGRESS'
                </sqlCheck>
            </and>
        </preConditions>
        <insert tableName="plan_feature">
            <column name="plan_id" valueComputed="(SELECT id FROM plan WHERE code = 'STARTER')"/>
            <column name="feature_id" valueComputed="(SELECT id FROM feature WHERE code = 'MODULE_WORK_PROGRESS')"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <rollback>
            <delete tableName="plan_feature">
                <where>plan_id = (SELECT id FROM plan WHERE code = 'STARTER') AND feature_id = (SELECT id FROM feature WHERE code = 'MODULE_WORK_PROGRESS')</where>
            </delete>
        </rollback>
    </changeSet>

    <changeSet id="work-progress-002-grant-module-work-progress-pro" author="echno">
        <preConditions onFail="MARK_RAN">
            <and>
                <sqlCheck expectedResult="1">SELECT COUNT(*) FROM plan WHERE code = 'PRO'</sqlCheck>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM plan_feature pf
                    JOIN plan p ON p.id = pf.plan_id
                    JOIN feature f ON f.id = pf.feature_id
                    WHERE p.code = 'PRO' AND f.code = 'MODULE_WORK_PROGRESS'
                </sqlCheck>
            </and>
        </preConditions>
        <insert tableName="plan_feature">
            <column name="plan_id" valueComputed="(SELECT id FROM plan WHERE code = 'PRO')"/>
            <column name="feature_id" valueComputed="(SELECT id FROM feature WHERE code = 'MODULE_WORK_PROGRESS')"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <rollback>
            <delete tableName="plan_feature">
                <where>plan_id = (SELECT id FROM plan WHERE code = 'PRO') AND feature_id = (SELECT id FROM feature WHERE code = 'MODULE_WORK_PROGRESS')</where>
            </delete>
        </rollback>
    </changeSet>

    <changeSet id="work-progress-002-grant-module-work-progress-enterprise" author="echno">
        <preConditions onFail="MARK_RAN">
            <and>
                <sqlCheck expectedResult="1">SELECT COUNT(*) FROM plan WHERE code = 'ENTERPRISE'</sqlCheck>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM plan_feature pf
                    JOIN plan p ON p.id = pf.plan_id
                    JOIN feature f ON f.id = pf.feature_id
                    WHERE p.code = 'ENTERPRISE' AND f.code = 'MODULE_WORK_PROGRESS'
                </sqlCheck>
            </and>
        </preConditions>
        <insert tableName="plan_feature">
            <column name="plan_id" valueComputed="(SELECT id FROM plan WHERE code = 'ENTERPRISE')"/>
            <column name="feature_id" valueComputed="(SELECT id FROM feature WHERE code = 'MODULE_WORK_PROGRESS')"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <rollback>
            <delete tableName="plan_feature">
                <where>plan_id = (SELECT id FROM plan WHERE code = 'ENTERPRISE') AND feature_id = (SELECT id FROM feature WHERE code = 'MODULE_WORK_PROGRESS')</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
