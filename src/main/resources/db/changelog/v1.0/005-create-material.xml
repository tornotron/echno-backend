<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-create-material" author="echno">
        <createTable tableName="material">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sku" type="VARCHAR(100)"/>
            <column name="material_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="unit" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="material" indexName="idx_material_sku">
            <column name="sku"/>
        </createIndex>

        <createIndex tableName="material" indexName="idx_material_name">
            <column name="material_name"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
