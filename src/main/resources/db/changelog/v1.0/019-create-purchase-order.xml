<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="019-create-purchase-order" author="echno">
        <createTable tableName="purchase_order">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="po_number" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_purchase_order_number"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="expected_delivery_date" type="TIMESTAMP"/>
            <column name="remarks" type="TEXT"/>
            <column name="total_amount" type="DECIMAL(15,2)"/>
            <column name="vendor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="intend_id" type="BIGINT"/>
            <column name="created_by_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="purchase_order"
                baseColumnNames="vendor_id"
                constraintName="fk_purchase_order_vendor"
                referencedTableName="vendor"
                referencedColumnNames="id"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="purchase_order"
                baseColumnNames="intend_id"
                constraintName="fk_purchase_order_intend"
                referencedTableName="intend"
                referencedColumnNames="id"
                onDelete="SET NULL"/>

        <addForeignKeyConstraint
                baseTableName="purchase_order"
                baseColumnNames="created_by_id"
                constraintName="fk_purchase_order_created_by"
                referencedTableName="users_table"
                referencedColumnNames="id"
                onDelete="SET NULL"/>

        <createIndex tableName="purchase_order" indexName="idx_purchase_order_vendor">
            <column name="vendor_id"/>
        </createIndex>

        <createIndex tableName="purchase_order" indexName="idx_purchase_order_intend">
            <column name="intend_id"/>
        </createIndex>

        <createIndex tableName="purchase_order" indexName="idx_purchase_order_created_by">
            <column name="created_by_id"/>
        </createIndex>

        <createIndex tableName="purchase_order" indexName="idx_purchase_order_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
