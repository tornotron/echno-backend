<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="027-create-inventory-transaction" author="echno">
        <createTable tableName="inventory_transaction">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="transaction_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="opening_stock" type="INT"/>
            <column name="quantity_changed" type="INT"/>
            <column name="closing_stock" type="INT"/>
            <column name="transaction_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="reference_number" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="remarks" type="TEXT"/>
            <column name="material_id" type="BIGINT"/>
            <column name="created_by_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="inventory_transaction"
                baseColumnNames="material_id"
                constraintName="fk_inventory_transaction_material"
                referencedTableName="material"
                referencedColumnNames="id"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="inventory_transaction"
                baseColumnNames="created_by_id"
                constraintName="fk_inventory_transaction_created_by"
                referencedTableName="users_table"
                referencedColumnNames="id"
                onDelete="SET NULL"/>

        <createIndex tableName="inventory_transaction" indexName="idx_inventory_transaction_material">
            <column name="material_id"/>
        </createIndex>

        <createIndex tableName="inventory_transaction" indexName="idx_inventory_transaction_created_by">
            <column name="created_by_id"/>
        </createIndex>

        <createIndex tableName="inventory_transaction" indexName="idx_inventory_transaction_date">
            <column name="transaction_date"/>
        </createIndex>

        <createIndex tableName="inventory_transaction" indexName="idx_inventory_transaction_type">
            <column name="transaction_type"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
