<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="043-create-leave-approval" author="echno">
        <createTable tableName="leave_approval">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="leave_request_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="approver_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="approval_level" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="comments" type="VARCHAR(1000)"/>
            <column name="delegated_from_id" type="BIGINT"/>
            <column name="action_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="leave_approval"
                baseColumnNames="leave_request_id"
                constraintName="fk_leave_approval_request"
                referencedTableName="leave_request"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="leave_approval"
                baseColumnNames="approver_id"
                constraintName="fk_leave_approval_approver"
                referencedTableName="employee"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="leave_approval"
                baseColumnNames="delegated_from_id"
                constraintName="fk_leave_approval_delegated_from"
                referencedTableName="employee"
                referencedColumnNames="id"
                onDelete="SET NULL"/>

        <createIndex tableName="leave_approval" indexName="idx_leave_approval_request">
            <column name="leave_request_id"/>
        </createIndex>

        <createIndex tableName="leave_approval" indexName="idx_leave_approval_approver">
            <column name="approver_id"/>
        </createIndex>

        <createIndex tableName="leave_approval" indexName="idx_leave_approval_action">
            <column name="action"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
