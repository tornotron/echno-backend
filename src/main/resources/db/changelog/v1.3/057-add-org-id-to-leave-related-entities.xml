<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- leave_approval -->
    <changeSet id="057-01-add-org-id-to-leave-approval" author="echno">
        <addColumn tableName="leave_approval">
            <column name="organization_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint
                baseTableName="leave_approval"
                baseColumnNames="organization_id"
                constraintName="fk_leave_approval_organization"
                referencedTableName="organization"
                referencedColumnNames="id"
                onDelete="RESTRICT"/>
        <createIndex tableName="leave_approval" indexName="idx_leave_approval_organization">
            <column name="organization_id"/>
        </createIndex>
    </changeSet>

