<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="062-create-project-employees" author="echno">
        <createTable tableName="project_employees">
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="project_employees"
                columnNames="project_id, employee_id"
                constraintName="pk_project_employees"/>

        <addForeignKeyConstraint
                baseTableName="project_employees"
                baseColumnNames="project_id"
                constraintName="fk_project_employees_project"
                referencedTableName="project"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="project_employees"
                baseColumnNames="employee_id"
                constraintName="fk_project_employees_employee"
                referencedTableName="employee"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex tableName="project_employees" indexName="idx_project_employees_project">
            <column name="project_id"/>
        </createIndex>

        <createIndex tableName="project_employees" indexName="idx_project_employees_employee">
            <column name="employee_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
