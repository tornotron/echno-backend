                baseColumnNames="handover_to_id"
                constraintName="fk_leave_request_handover"
                referencedTableName="employee"
                referencedColumnNames="id"
                onDelete="SET NULL"/>

        <createIndex tableName="leave_request" indexName="idx_leave_request_employee">
