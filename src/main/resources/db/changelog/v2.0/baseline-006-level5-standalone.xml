    <!-- leave_request_sequence (unchanged from 047) -->
    <changeSet id="baseline-006-create-leave-request-sequence" author="echno-baseline">
        <createTable tableName="leave_request_sequence">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organization_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="year" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="last_sequence" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
