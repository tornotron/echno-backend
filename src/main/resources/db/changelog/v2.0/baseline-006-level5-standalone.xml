<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ============================================================== -->
    <!-- Baseline Level 5: Standalone / leave management tables         -->
    <!-- Consolidates: v1.0 (032), v1.2 (040-047), v1.3 (057)          -->
    <!-- ============================================================== -->

    <!-- usage_record (unchanged from 032) -->
    <changeSet id="baseline-006-create-usage-record" author="echno-baseline">
        <createTable tableName="usage_record">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="subscription_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="feature_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="usage_amount" type="BIGINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="period_start" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="period_end" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="resource_id" type="VARCHAR(255)"/>
        </createTable>

        <createIndex tableName="usage_record" indexName="idx_usage_user_feature">
            <column name="user_id"/>
            <column name="feature_id"/>
        </createIndex>
        <createIndex tableName="usage_record" indexName="idx_usage_subscription">
            <column name="subscription_id"/>
        </createIndex>
        <createIndex tableName="usage_record" indexName="idx_usage_period">
            <column name="period_start"/>
            <column name="period_end"/>
        </createIndex>
        <createIndex tableName="usage_record" indexName="idx_usage_feature_period">
            <column name="feature_id"/>
            <column name="period_start"/>
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <!-- leave_policy (from v1.2 040) -->
    <changeSet id="baseline-006-create-leave-policy" author="echno-baseline">
        <createTable tableName="leave_policy">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organization_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="leave_type_code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="leave_type_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="annual_quota" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="accrual_rate_per_month" type="DOUBLE PRECISION"/>
            <column name="carry_forward_limit" type="DOUBLE PRECISION"/>
            <column name="carry_forward_expiry_months" type="INTEGER"/>
            <column name="min_days_per_request" type="DOUBLE PRECISION" defaultValueNumeric="0.5"/>
            <column name="max_days_per_request" type="DOUBLE PRECISION"/>
            <column name="advance_notice_days" type="INTEGER" defaultValueNumeric="0"/>
            <column name="requires_attachment" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="attachment_required_after_days" type="INTEGER"/>
            <column name="applicable_genders" type="VARCHAR(50)" defaultValue="ALL"/>
            <column name="min_service_months" type="INTEGER" defaultValueNumeric="0"/>
            <column name="allow_half_day" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="is_paid" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="display_order" type="INTEGER" defaultValueNumeric="0"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="leave_policy"
                baseColumnNames="organization_id"
                constraintName="fk_leave_policy_organization"
                referencedTableName="organization"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex tableName="leave_policy" indexName="idx_leave_policy_org">
            <column name="organization_id"/>
        </createIndex>
        <createIndex tableName="leave_policy" indexName="idx_leave_policy_type_code">
            <column name="leave_type_code"/>
        </createIndex>
        <createIndex tableName="leave_policy" indexName="idx_leave_policy_active">
            <column name="is_active"/>
        </createIndex>
        <addUniqueConstraint
                tableName="leave_policy"
                columnNames="organization_id, leave_type_code"
                constraintName="uk_leave_policy_org_type"/>
    </changeSet>

    <!-- leave_balance (squashed: 041 + 057-02 org_id) -->
    <changeSet id="baseline-006-create-leave-balance" author="echno-baseline">
        <createTable tableName="leave_balance">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="leave_policy_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="year" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="opening_balance" type="DOUBLE PRECISION" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="accrued" type="DOUBLE PRECISION" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="used" type="DOUBLE PRECISION" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="pending" type="DOUBLE PRECISION" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="carry_forward_from_previous" type="DOUBLE PRECISION" defaultValueNumeric="0"/>
            <column name="carry_forward_expiry_date" type="DATE"/>
            <column name="last_calculated_at" type="TIMESTAMP"/>
            <column name="last_calculation_month" type="INTEGER"/>
            <!-- Added in v1.3 (057-02) -->
            <column name="organization_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="leave_balance"
                baseColumnNames="employee_id"
                constraintName="fk_leave_balance_employee"
                referencedTableName="employee"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
        <addForeignKeyConstraint
                baseTableName="leave_balance"
                baseColumnNames="leave_policy_id"
                constraintName="fk_leave_balance_policy"
                referencedTableName="leave_policy"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
        <addForeignKeyConstraint
                baseTableName="leave_balance"
                baseColumnNames="organization_id"
                constraintName="fk_leave_balance_organization"
                referencedTableName="organization"
                referencedColumnNames="id"
                onDelete="RESTRICT"/>

        <createIndex tableName="leave_balance" indexName="idx_leave_balance_employee">
            <column name="employee_id"/>
        </createIndex>
        <createIndex tableName="leave_balance" indexName="idx_leave_balance_policy">
            <column name="leave_policy_id"/>
        </createIndex>
        <createIndex tableName="leave_balance" indexName="idx_leave_balance_year">
            <column name="year"/>
        </createIndex>
        <createIndex tableName="leave_balance" indexName="idx_leave_balance_organization">
            <column name="organization_id"/>
        </createIndex>
        <addUniqueConstraint
                tableName="leave_balance"
                columnNames="employee_id, leave_policy_id, year"
                constraintName="uk_leave_balance_emp_policy_year"/>
    </changeSet>

