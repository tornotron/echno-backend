<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ============================================================== -->
    <!-- Add organization_id to vendor child tables for org-scoped      -->
    <!-- Hibernate filter (orgFilter) support                           -->
    <!-- ============================================================== -->

    <!-- vendor_contact -->
    <changeSet id="077-01-add-org-id-to-vendor-contact" author="echno">
        <addColumn tableName="vendor_contact">
            <column name="organization_id" type="BIGINT"/>
        </addColumn>

        <sql>
            UPDATE vendor_contact vc
            SET organization_id = (SELECT v.organization_id FROM vendor v WHERE v.id = vc.vendor_id)
        </sql>

        <addNotNullConstraint tableName="vendor_contact" columnName="organization_id" columnDataType="BIGINT"/>

        <addForeignKeyConstraint
                baseTableName="vendor_contact"
                baseColumnNames="organization_id"
                constraintName="fk_vendor_contact_organization"
                referencedTableName="organization"
                referencedColumnNames="id"/>

        <createIndex tableName="vendor_contact" indexName="idx_vendor_contact_org">
            <column name="organization_id"/>
        </createIndex>
    </changeSet>

