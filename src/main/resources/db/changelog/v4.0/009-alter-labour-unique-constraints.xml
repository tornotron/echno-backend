<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="009-alter-labour-unique-constraints" author="echno">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="labour"/>
        </preConditions>

        <addUniqueConstraint tableName="labour"
                             columnNames="email"
                             constraintName="uq_labour_email"/>

        <addUniqueConstraint tableName="labour"
                             columnNames="phone_number"
                             constraintName="uq_labour_phone_number"/>

        <addUniqueConstraint tableName="labour"
                             columnNames="bank_account_number"
                             constraintName="uq_labour_bank_account_number"/>
    </changeSet>

</databaseChangeLog>
