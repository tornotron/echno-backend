<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="013-create-document-sequence" author="echno">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="document_sequence"/>
            </not>
        </preConditions>

        <createTable tableName="document_sequence">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="doc_type" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="fiscal_year" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="next_value" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="document_sequence"
                             columnNames="doc_type, fiscal_year"
                             constraintName="uk_document_sequence_type_year"/>
    </changeSet>

</databaseChangeLog>
