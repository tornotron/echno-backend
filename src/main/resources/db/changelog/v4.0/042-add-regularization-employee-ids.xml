<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="042-add-regularization-employee-ids" author="echno">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="attendance_regularization" columnName="requested_by_id"/>
            </not>
        </preConditions>

        <comment>
            Store the employee ids of the requester and the approver alongside the existing free-text
            requested_by / approved_by names, so regularization requests can be filtered by requester
            or approver. Both nullable: the client supplies the id when known, and older rows are
            backfilled best-effort in a following changeset.
        </comment>

        <addColumn tableName="attendance_regularization">
            <column name="requested_by_id" type="BIGINT"/>
            <column name="approved_by_id" type="BIGINT"/>
        </addColumn>

        <createIndex tableName="attendance_regularization" indexName="idx_attendance_regularization_requested_by_id">
            <column name="requested_by_id"/>
        </createIndex>
        <createIndex tableName="attendance_regularization" indexName="idx_attendance_regularization_approved_by_id">
            <column name="approved_by_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
