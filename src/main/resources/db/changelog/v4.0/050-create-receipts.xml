<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="050-create-receipts" author="echno">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="receipts"/>
            </not>
        </preConditions>

        <createTable tableName="receipts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="receipt_number" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <column name="type" type="VARCHAR(50)"/>
            <column name="status" type="VARCHAR(50)"/>

            <column name="amount" type="NUMERIC(15, 2)"/>
            <column name="currency" type="VARCHAR(10)"/>
            <column name="receipt_date" type="DATE"/>
            <column name="payment_method" type="VARCHAR(255)"/>

            <column name="transaction_id" type="VARCHAR(255)"/>
            <column name="reference_number" type="VARCHAR(255)"/>
            <column name="received_from" type="VARCHAR(255)"/>
            <column name="received_from_address" type="TEXT"/>

            <column name="tax_amount" type="NUMERIC(15, 2)"/>
            <column name="tax_rate" type="NUMERIC(6, 2)"/>
            <column name="tax_type" type="VARCHAR(50)"/>

            <column name="description" type="TEXT"/>
            <column name="notes" type="TEXT"/>
            <column name="issued_by" type="BIGINT"/>

            <column name="project_id" type="BIGINT"/>
            <column name="payment_id" type="BIGINT"/>
            <column name="invoice_id" type="BIGINT"/>
            <column name="customer_id" type="BIGINT"/>

            <column name="organization_id" type="BIGINT"/>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="receipts"
                                 baseColumnNames="organization_id"
                                 constraintName="fk_receipt_organization"
                                 referencedTableName="organization"
                                 referencedColumnNames="id"
                                 onDelete="RESTRICT"/>

        <addUniqueConstraint tableName="receipts"
                             columnNames="organization_id, receipt_number"
                             constraintName="uk_receipt_number"/>

        <createIndex tableName="receipts" indexName="idx_receipt_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="receipts" indexName="idx_receipt_type">
            <column name="type"/>
        </createIndex>
        <createIndex tableName="receipts" indexName="idx_receipt_project">
            <column name="project_id"/>
        </createIndex>
        <createIndex tableName="receipts" indexName="idx_receipt_organization">
            <column name="organization_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
