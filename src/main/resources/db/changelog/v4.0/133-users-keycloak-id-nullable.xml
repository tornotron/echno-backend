<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Accounts are read through user_identity now, and a user under another provider has no
        Keycloak id. The column stays for Keycloak users until the build plan's step 33 drops it.
    -->
    <changeSet id="133-users-keycloak-id-nullable" author="abhijith">
        <dropNotNullConstraint tableName="users_table" columnName="keycloak_id" columnDataType="VARCHAR(255)"/>
    </changeSet>

</databaseChangeLog>
