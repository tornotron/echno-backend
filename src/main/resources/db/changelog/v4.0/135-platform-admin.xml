<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Echno's own staff, recorded here because the provider knows nothing about roles. Rows are
         added by runbook; nothing in the application writes them. -->
    <changeSet id="135-create-platform_admin" author="abhijith">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="platform_admin"/></not>
        </preConditions>
        <createTable tableName="platform_admin">
            <column name="user_id" type="BIGINT"><constraints primaryKey="true" primaryKeyName="pk_platform_admin" nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="platform_admin" baseColumnNames="user_id"
                                 referencedTableName="users_table" referencedColumnNames="id"
                                 constraintName="fk_platform_admin_user" onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
